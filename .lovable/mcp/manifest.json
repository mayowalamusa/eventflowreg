{
  "version": 1,
  "sdk_version": "1.0.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://libtexgniuavbjpyggto.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "event-flow-dashboard",
      "version": "0.1.0",
      "title": "Event Flow Dashboard"
    },
    "tools": [
      {
        "name": "list_events",
        "title": "List my events",
        "description": "List the signed-in host's events with their status, date and registration URL slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Maximum number of events to return (default 20)."
            },
            "published_only": {
              "type": "boolean",
              "description": "Only return published events."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_event",
        "title": "Get event details",
        "description": "Get full details for one of the signed-in host's events, by event id or URL slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "minLength": 1,
              "description": "The event id (UUID) or URL slug."
            }
          },
          "required": [
            "event"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_registrations",
        "title": "List registrations",
        "description": "List attendee registrations for one of the signed-in host's events, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "minLength": 1,
              "description": "The event id (UUID) to list registrations for."
            },
            "search": {
              "type": "string",
              "description": "Optional name or email substring to filter by."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Maximum rows to return (default 50)."
            }
          },
          "required": [
            "event_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "event_stats",
        "title": "Event statistics",
        "description": "Summarise the signed-in host's events: totals, published/active counts and registration totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
